############################################
# Project Settings
############################################

project_name = "cloudforge-jenkins"
region       = "eu-central-1"
app_subdomain = "app"


############################################
# Secrets Backend Configuration
############################################

# Options:
#   "ssm"            → store secrets only in SSM Parameter Store
#   "secretsmanager" → store secrets only in AWS Secrets Manager
#   "both"           → store secrets in both backends
secret_backend = "ssm"

# If using Secrets Manager:
#   false → secrets are protected from deletion (prevent_destroy = true)
#   true  → secrets can be destroyed by Terraform
destroy_secrets = false

############################################
# Jenkins Credentials
############################################

# Jenkins admin password (stored in SSM/Secrets Manager)
jenkins_admin_password = "CHANGE_ME"

# GitHub Personal Access Token (stored in SSM/Secrets Manager)
github_pat = "CHANGE_ME"

############################################
# Network Configuration
############################################

vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr_a  = "10.0.1.0/24"
public_subnet_cidr_b  = "10.0.2.0/24"
private_subnet_cidr_a = "10.0.3.0/24"
private_subnet_cidr_b = "10.0.4.0/24"

az_a = "eu-central-1a"
az_b = "eu-central-1b"

############################################
# Jenkins + EC2 Settings
############################################

jenkins_port     = 8080
instance_type    = "t3.micro"
root_volume_size = 20
root_volume_type = "gp3"

############################################
# ACM Certificate (optional)
############################################

# If using HTTPS via ALB:
# acm_certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/xxxx"
acm_certificate_arn = null
